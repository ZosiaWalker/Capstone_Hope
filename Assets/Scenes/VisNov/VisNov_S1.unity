        ","$type":"System.String"},{"$content":"Player","$type":"System.String"},{"$content":"
        ","$type":"System.String"},{"$content":"Green","$type":"System.String"},{"$content":"Player","$type":"System.String"},{"$content":"
        ","$type":"System.String"},{"$content":"Player","$type":"System.String"},{"$content":"
        ","$type":"System.String"},{"$content":"Green","$type":"System.String"},{"$content":"Player","$type":"System.String"},{"$content":"Green","$type":"System.String"},{"$content":"Player","$type":"System.String"},{"$content":"Green","$type":"System.String"},{"$content":"
